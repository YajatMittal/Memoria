# Copy to backend/.env and fill in. Never commit the real .env file.

# Long random string used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey) — powers the memory assistant.
GEMINI_API_KEY=
# Optional: pin a specific model instead of the rolling "latest Flash" alias.
# GEMINI_MODEL=gemini-flash-latest

# Optional: SMTP credentials for sending verification codes.
# If left blank, codes are printed in the server console instead (fine for local dev).
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_SENDER=

# Optional
# DATABASE_URL=sqlite:///memoria.db
# NOMINATIM_USER_AGENT=Memoria/1.0 (contact: you@example.com)
# CORS_ORIGINS=*
# FLASK_DEBUG=1
# PORT=5001
