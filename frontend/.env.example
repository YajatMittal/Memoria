# Copy to frontend/.env. Only EXPO_PUBLIC_* values are bundled into the app, so
# NEVER put secrets (like the Gemini key) here — those belong in backend/.env.

# URL of the Memoria API. When testing on a physical phone with Expo Go, use your
# computer's LAN IP (e.g. http://192.168.1.20:5001), not localhost.
EXPO_PUBLIC_API_URL=http://localhost:5001
