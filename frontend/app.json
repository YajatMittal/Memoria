{
  "expo": {
    "name": "Memoria",
    "slug": "memoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memoria",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F6F4FB"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F4FB"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Memoria uses your camera so you can take photos of moments you want to remember.",
          "photosPermission": "Memoria lets you choose photos from your library to save as memories."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Memoria uses your location to remind you to take photos when you visit somewhere new."
        }
      ],
      "expo-notifications",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
